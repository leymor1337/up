Функция ЦенаБлюда(Блюдо, НаДату)
	Данные = РегистрыСведений.ЦеныБлюд.ПолучитьПоследнее(НаДату, Новый Структура("Блюдо", Блюдо));
	Возврат Данные.Цена;
КонецФункции

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	// Задача 06: закрытый заказ изменять нельзя
	Если НЕ ЭтоНовый() И Ссылка.Закрыт Тогда
		Сообщить("Заказ закрыт, изменение запрещено.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	// Задача 06: на один столик - один открытый заказ
	Если НЕ Закрыт И Столик > 0 Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 З.Ссылка ИЗ Документ.ЗаказПосетителя КАК З
		|ГДЕ З.Ресторан = &Ресторан И З.Столик = &Столик И НЕ З.Закрыт
		|И НЕ З.ПометкаУдаления И З.Ссылка <> &Ссылка");
		Запрос.УстановитьПараметр("Ресторан", Ресторан);
		Запрос.УстановитьПараметр("Столик", Столик);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Сообщить("На столик " + Столик + " уже открыт другой заказ.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Задача 06: дата закрытия проставляется автоматически
	Если Закрыт И НЕ ЗначениеЗаполнено(ДатаЗакрытия) Тогда
		ДатаЗакрытия = ТекущаяДата();
	КонецЕсли;
	// Задача 10: цена на дату заказа и сумма
	Итого = 0;
	Для Каждого Стр Из Блюда Цикл
		Если Стр.Цена = 0 Тогда
			Стр.Цена = ЦенаБлюда(Стр.Блюдо, Дата);
		КонецЕсли;
		Стр.Сумма = Стр.Количество * Стр.Цена;
		Итого = Итого + Стр.Сумма;
	КонецЦикла;
	Если ЗначениеЗаполнено(Карта) Тогда
		Скидка = Карта.ТипКарты.Скидка;
		Итого = Итого * (100 - Скидка) / 100;
	КонецЕсли;
	СуммаЗаказа = Итого;
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если Закрыт Тогда
		Сообщить("Закрытый заказ удалять нельзя.");
		Отказ = Истина;
	ИначеЕсли СуммаЗаказа > 0 Тогда
		Сообщить("Удаление заказа с ненулевой суммой запрещено. Используйте пометку удаления.");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
