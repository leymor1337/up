Функция СоставРецепта(Таб)
	Результат = "";
	Для Каждого Стр Из Таб Цикл
		Результат = Результат + Строка(Стр.Ингредиент.УникальныйИдентификатор()) + ":" + Стр.Количество + ";";
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПередЗаписью(Отказ)
	// Задача 27а: рецепт и время приготовления меняет только Повар
	Если НЕ РольДоступна("Повар") И НЕ РольДоступна("Администратор") Тогда
		Если ЭтоНовый() Тогда
			Изменен = Рецепт.Количество() > 0 ИЛИ ВремяПриготовления > 0;
		Иначе
			Изменен = СоставРецепта(Рецепт) <> СоставРецепта(Ссылка.Рецепт) ИЛИ ВремяПриготовления <> Ссылка.ВремяПриготовления;
		КонецЕсли;
		Если Изменен Тогда
			Отказ = Истина;
			Сообщить("Рецепт могут редактировать только пользователи с ролью Повар");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Задача 04: меню редактируют Администратор и Менеджер ресторана (Повар - только рецепт)
	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() > 0
		И НЕ РольДоступна("Администратор") И НЕ РольДоступна("МенеджерРесторана") И НЕ РольДоступна("Повар") Тогда
		Отказ = Истина;
		Сообщить("Редактировать меню могут только Администратор и Менеджер ресторана");
	КонецЕсли;
КонецПроцедуры
